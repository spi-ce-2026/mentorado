# =============================================================================
# mentoradoApp - Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o arquivo .env com valores reais.
#
# Variáveis EXPO_PUBLIC_* são injetadas no bundle do app (visíveis no cliente).
# Variáveis sem esse prefixo só ficam disponíveis em app.config.js (build).
# =============================================================================

# -----------------------------------------------------------------------------
# URL da API Gateway (opcional)
# Sem esta variável, o app usa o backend de integração no Heroku:
#   https://mentorias-api-gateway-10fcbc088ede.herokuapp.com/api/v1
# Defina só se o professor indicar outro backend, por exemplo um que rode no
# computador e seja acessado pelo emulador Android: http://10.0.2.2:8080/api/v1
# -----------------------------------------------------------------------------
# EXPO_PUBLIC_API_BASE_URL=

# -----------------------------------------------------------------------------
# Google OAuth Client ID
# Firebase Console > Authentication > Sign-in method > Google > Web client ID
# -----------------------------------------------------------------------------
EXPO_PUBLIC_GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# Firebase Configuration
# Firebase Console > Project Settings > Your apps > mentoradoApp (Android)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=sua-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:android:xxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Expo Project ID (opcional — necessário para builds EAS)
# expo.dev > seu projeto > Project ID
# -----------------------------------------------------------------------------
EXPO_PUBLIC_PROJECT_ID=seu-expo-project-id
